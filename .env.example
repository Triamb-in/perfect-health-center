# ==============================================================================
# PERFECT HEALTH CENTER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Upstash Redis (For Serverless Distributed Rate Limiting on Vercel)
# Create a free Redis database at https://console.upstash.com/
# After creating the DB, go to Details → REST API to get these values.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Resend (Email Notifications — free tier: 100 emails/day)
# Sign up at https://resend.com → API Keys → Create API Key
# On the free sandbox plan, emails can be sent to the account owner.
# Once perfecthealthcenter.in is verified in Resend, you can send to any email from @perfecthealthcenter.in.
RESEND_API_KEY="re_your_resend_api_key"
CLINIC_NOTIFICATION_EMAIL="pragativuplekar@gmail.com"
CLINIC_FROM_EMAIL="Perfect Health Center <appointments@perfecthealthcenter.in>"

# Sanity CMS Configuration (Optional / For Direct Self-Service Content Updates)
# Create a free project at https://www.sanity.io/
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-03-01"
SANITY_API_READ_TOKEN="your_sanity_read_token"

# Base URL (for Canonical and OpenGraph links)
NEXT_PUBLIC_SITE_URL="https://perfecthealthcenter.in"

# Media Vault Security (HMAC-SHA256 signature secret for watermarked media)
MEDIA_SIGNING_SECRET="generate_a_random_64_hex_secret_here"
